 "machines": {
  "M0": "cross-entropy on half B, as M_0 of E2, E2 bis and E2 ter",
  "M0plus": "a copy of M0 fine-tuned on half B with cross-entropy: 10 epochs, learning rate the pilot's divided by 5 (0.02), cosine from it to zero",
  "Mdue": "a copy of M0 fine-tuned as M0plus (same seed, batch order, crops, flips and frames); loss: its cross-entropy plus the binary cross-entropy of the summed log-odds (out1 - out0) + z_H, as in E2 ter",
  "Mramo_w": "M0 frozen (eval mode) plus a branch: a new network that sees the framed image with its interior set to zero, trained from scratch with the pilot's epochs, learning rate and one-cycle schedule on the binary cross-entropy of z_H + w * (z_M0 + z_branch), H and M0 frozen, whole framed presentation, no gradient; recorded cue z_M0 + z_branch. One branch per w in [0.5, 1.0, 2.0, 4.0]; the branches share seed, batch order, crops, flips and frames"
 },
 "frame": "the outer 2-pixel border of all three channels is set to a * delta, in normalised units (after per-channel normalisation), applied after crop and flip, without clipping",
 "delta": 1.0,
 "torch_seeds": "the labels of E2 ter on new seeds: H and M0 crc32('rephase/<task>/s<seed>/<H|M>') & 0x7fffffff; M0plus and Mdue crc32('rephase/<task>/s<seed>/ter'); every branch crc32('rephase/<task>/s<seed>/ramo')",
 "test_and_validation_frames": "numpy default_rng(crc32('rephase/<task>/s<seed>/<test|val>-a')), a = sqrt(2) * eps",
