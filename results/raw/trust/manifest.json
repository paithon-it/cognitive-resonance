  "optimiser": "SGD, Nesterov momentum 0.9, weight decay 5e-4, one-cycle schedule (PyTorch OneCycleLR defaults), bf16 autocast",
  "augmentation": "random 32x32 crop of the image reflect-padded by 4 pixels, random horizontal flip",
